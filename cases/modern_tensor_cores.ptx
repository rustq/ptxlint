//
// Modern PTX: tensor cores, async copy, barriers.
//
.version 8.4
.target sm_90a
.address_size 64

.visible .entry hgemm_tc(
	.param .u64 a_ptr,
	.param .u64 b_ptr,
	.param .u64 c_ptr
)
{
	.reg .b32 	%r<32>;
	.reg .b64 	%rd<8>;
	.shared .align 16 .b8 smem[16384];
	.reg .f32 	%f<16>;

	ld.param.u64 	%rd1, [a_ptr];
	cvta.to.global.u64 	%rd2, %rd1;
	cp.async.cg.shared.global [smem], [%rd2], 16;
	cp.async.commit_group;
	cp.async.wait_group 0;
	bar.sync 	0;
	wmma.load.a.sync.aligned.row.m16n16k16.shared.f16 {%r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8}, [smem];
	wmma.mma.sync.aligned.row.col.m16n16k16.f32.f32 {%f1, %f2, %f3, %f4, %f5, %f6, %f7, %f8}, {%r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8}, {%r9, %r10, %r11, %r12, %r13, %r14, %r15, %r16}, {%f9, %f10, %f11, %f12, %f13, %f14, %f15, %f16};
	st.global.f32 	[%rd2], %f1;
	ret;
}
